# ---- 安全：密钥绝不能进仓库 ----
.env
.env.*
*.env
!.env.example
config/secrets.yaml
*.key

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
build/
dist/

# ---- 运行时产物 ----
projects/
outputs/
models/
weights/
.cache/
*.log

