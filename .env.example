# 复制为 .env 后填入真实值；.env 已被 .gitignore 屏蔽，绝不会进仓库
# Windows 上可直接运行 scripts/setup_windows.ps1 自动生成（全部装到 D 盘）
# 在 AutoDL 上也可不落盘：read -s DEEPSEEK_API_KEY && export DEEPSEEK_API_KEY

# ---------------- 密钥 ----------------
DEEPSEEK_API_KEY=sk-在这里填你自己的key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---------------- 路径（Windows 默认 D 盘，不占系统盘）----------------
# 数据根目录：模型、缓存、工具都放这里
AUTODRAMA_DATA_ROOT=D:/autodrama
AUTODRAMA_MODEL_DIR=D:/autodrama/models
# ffmpeg 的 bin 目录（不加入 PATH 也能用）
AUTODRAMA_BIN_DIR=D:/autodrama/tools/ffmpeg/bin
# AutoDL 上改成：AUTODRAMA_DATA_ROOT=/root/autodl-tmp

# ---------------- 后端：mock / local / command ----------------
AUTODRAMA_LLM=deepseek
AUTODRAMA_IMAGE=mock
AUTODRAMA_VIDEO=mock
AUTODRAMA_TTS=mock

# 图像模型（AUTODRAMA_IMAGE=local 时生效，基于 diffusers）
AUTODRAMA_IMAGE_MODEL=stabilityai/stable-diffusion-xl-base-1.0
AUTODRAMA_IP_ADAPTER=h94/IP-Adapter
AUTODRAMA_IP_SCALE=0.85
# 用场景定场图做 img2img 底图的强度（0=关闭，0.3~0.45 场景一致性最好）
AUTODRAMA_SCENE_INIT_STRENGTH=0.35

# 命令模板模式（AUTODRAMA_VIDEO=command 时生效，适配任意模型）
# 占位符：{keyframe} {last_frame} {prompt} {duration} {out} {width} {height}
# AUTODRAMA_VIDEO_CMD=python /root/h3/infer.py --img "{keyframe}" --last "{last_frame}" --prompt "{prompt}" --dur {duration} --out "{out}"
# 占位符：{text} {voice} {emotion} {out}
# AUTODRAMA_TTS_CMD=python /root/CosyVoice/infer.py --text "{text}" --voice "{voice}" --emotion "{emotion}" --out "{out}"

# ---------------- 生成参数 ----------------
AUTODRAMA_WIDTH=720
AUTODRAMA_HEIGHT=1280
AUTODRAMA_FPS=24
# 每个镜头候选数 >1 时，用 face 相似度自动挑最像角色的一张
AUTODRAMA_CANDIDATES=3
AUTODRAMA_AUTO_PICK=1
AUTODRAMA_USE_LIPSYNC=0
AUTODRAMA_AUTO_APPROVE=0

# 字幕字体（中文必须指定，否则 ffmpeg 画不出汉字）
AUTODRAMA_FONT=C:/Windows/Fonts/msyh.ttc
